  "scripts": {
    "build": "bun run --bun next build",
    "check": "bun run --bun next lint && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "bun run --bun next dev --turbo",
    "dev:https": "bun run --bun next dev --turbo --experimental-https",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "bun run --bun next build && bun run --bun next start",
    "start": "bun run --bun next start",
    "typecheck": "tsc --noEmit"
  },
